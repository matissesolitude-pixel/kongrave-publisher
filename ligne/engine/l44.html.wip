 548.794 C-48.653 548.654 -60.606 551.607 -70.371 560.946 C-74.488 565.418 -74.488 565.418 -74.488 570.145 C-68.112 572.964 -62.862 573.625 -55.926 573.52 C-55.441 573.516 -55.441 573.516 -52.99 573.492 C-38.394 573.188 -21.104 570.3 -8.93 561.708 C-6.602 559.186 -7.159 556.874 -7.277 553.589 C-7.603 549.808 -8.305 546.173 -9.133 542.473 C-9.217 542.075 -9.217 542.075 -9.647 540.06 C-10.007 538.372 -10.37 536.685 -10.737 534.999 C-11.687 530.611 -12.6 526.217 -13.511 521.821 C-13.689 520.966 -13.866 520.112 -14.049 519.231 C-20.093 489.899 -21.009 460.69 -15.488 431.145 C-22.363 429.145 -22.363 429.145 -23.488 429.145 Z " fill="#20242A" transform="translate(360.488037109375,17.854736328125)"/><path d="M0 0 C9.804 8.653 15.512 23.659 16.559 36.387 C17.354 51.617 13.032 65.928 3.434 77.887 C-2.268 83.885 -9.302 88.031 -17.574 88.625 C-28.966 88.847 -37.217 86.884 -46.152 79.496 C-56.666 68.944 -61.196 54.13 -61.566 39.574 C-61.306 25.451 -57.116 11.569 -47.227 1.137 C-32.729 -11.724 -15.368 -11 0 0 Z M-42.922 7.594 C-52.281 18.803 -55.312 32.056 -54.254 46.387 C-52.534 57.903 -47.687 69.166 -38.254 76.387 C-31.259 81.167 -24.658 82.743 -16.254 81.387 C-8.863 79.059 -3.038 74.44 1.746 68.387 C1.746 67.727 1.746 67.067 1.746 66.387 C1.426 66.44 1.426 66.44 -0.195 66.711 C-6.11 67.531 -9.931 67.518 -15.254 64.387 C-20.538 60.086 -24.017 54.11 -25.254 47.387 C-25.321 45.304 -25.339 43.22 -25.316 41.137 C-25.307 40.059 -25.298 38.981 -25.289 37.871 C-25.277 37.051 -25.266 36.231 -25.254 35.387 C-24.181 35.758 -23.109 36.129 -22.004 36.512 C-18.254 37.387 -18.254 37.387 -15.879 36.824 C-14.254 35.387 -14.254 35.387 -13.316 33.074 C-13.236 29.637 -14.251 28.131 -16.254 25.387 C-16.914 24.727 -17.574 24.067 -18.254 23.387 C-18.254 21.012 -18.254 21.012 -17.254 18.387 C-13.693 15.009 -10.906 14.131 -6.129 14.074 C-3.022 14.166 -0.245 14.539 2.746 15.387 C-1.45 8.09 -7.338 1.958 -15.504 -0.613 C-26.208 -3.412 -35.13 0.072 -42.922 7.594 Z " fill="#20242A" transform="translate(361.25390625,118.61328125)"/><path d="M0 0 C1.32 0.33 2.64 0.66 4 1 C5.238 4.576 4.749 7.337 4 11 C5.579 11.986 7.164 12.963 8.75 13.938 C9.191 14.21 9.191 14.21 11.422 15.59 C16.934 18.605 22.83 18.674 29 18 C31.268 17.071 33.204 16.029 35.246 14.68 C37 14 37 14 39.223 14.883 C39.516 15.067 39.516 15.067 41 16 C41 18.188 41 18.188 40 21 C34.291 25.815 28.637 27.35 21.23 27.211 C13.65 26.494 7.521 23.426 1.227 19.305 C-0.916 18.049 -2.549 17.345 -5 17 C-5.639 17.33 -6.279 17.66 -6.938 18 C-9.64 19.31 -11.17 18.786 -14 18 C-14.688 16.188 -14.688 16.188 -15 14 C-13.412 11.758 -11.526 10.705 -9.188 9.25 C-5.44 6.605 -2.83 3.572 0 0 Z " fill="#20242A" transform="translate(357,211)"/><path d="M0 0 C1 1 1 1 1.062 3.562 C1.042 4.367 1.021 5.171 1 6 C-2.553 6.837 -5.615 7.009 -9.25 6.812 C-14.295 6.731 -17.644 7.789 -22.027 10.223 C-24.432 11.17 -25.606 10.851 -28 10 C-28.812 8.312 -28.812 8.312 -29 6 C-22.856 -2.397 -9.132 -5.008 0 0 Z " fill="#20242A" transform="translate(128,243)"/><path d="M0 0 C2.769 1.363 4.895 2.8 6.875 5.188 C7.062 7.875 7.062 7.875 6.875 10.188 C5.078 10.809 5.078 10.809 2.875 11.188 C1.803 10.548 0.73 9.909 -0.375 9.25 C-5.315 6.498 -10.177 6.912 -15.665 7.16 C-17.484 7.233 -19.305 7.217 -21.125 7.188 C-21.785 6.528 -22.445 5.868 -23.125 5.188 C-23 2.688 -23 2.688 -22.125 0.188 C-16.025 -3.955 -6.452 -2.765 0 0 Z " fill="#20242A" transform="translate(650.125,242.8125)"/><path d="M0 0 C12.991 0.241 26.065 8.109 35.312 16.812 C44.78 26.881 49.478 39.754 49.211 53.582 C47.876 68.879 42.253 81.512 31 92 C24.603 97.299 17.671 100.891 10 104 C9.443 104.227 9.443 104.227 6.625 105.375 C3.686 106.075 1.866 105.901 -1 105 C-2.96 103.04 -2.134 100.035 -2.147 97.425 C-2.146 96.478 -2.146 95.531 -2.145 94.555 C-2.149 93.563 -2.152 92.571 -2.155 91.549 C-2.165 88.253 -2.167 84.957 -2.168 81.66 C-2.171 79.38 -2.175 77.099 -2.178 74.818 C-2.184 70.031 -2.186 65.243 -2.185 60.455 C-2.185 54.307 -2.199 48.158 -2.216 42.01 C-2.227 37.298 -2.229 32.586 -2.229 27.873 C-2.23 25.606 -2.234 23.338 -2.242 21.071 C-2.252 17.905 -2.249 14.74 -2.243 11.574 C-2.249 10.629 -2.254 9.684 -2.26 8.711 C-2.256 7.851 -2.252 6.992 -2.247 6.106 C-2.248 5.357 -2.248 4.608 -2.249 3.836 C-2 2 -2 2 0 0 Z M7 11 C7 38.39 7 65.78 7 94 C16.664 92.067 25.883 85.621 31.723 77.648 C33.295 75.152 34.682 72.639 36 70 C36.342 69.326 36.683 68.652 37.035 67.957 C40.846 58.793 40.481 45.5 37.094 36.262 C30.974 23.606 20.996 15.906 8 11 C7.67 11 7.34 11 7 11 Z " fill="#20242A" transform="translate(399,285)"/></g>`;
    /* ═══════════════════════════════════════════════════════════════════════════
   MR DOLLAR — BIBLIOTHÈQUE DE GAGS (primitives réutilisables)
   Codé UNE fois, branché sur chaque épisode. Aucun sur-mesure par Reel.

   Doctrine (Bible, PARTIE II bis) :
   · Le gag ouvre S1, dure ~1 à 1,5 s, puis IL PASSE LA MAIN.
   · Mr Dollar est PETIT, en ENCRE #20242A, jamais en teal. Il souffre
     COMIQUEMENT (cartoon, sans conséquence) ; la boule teal souffre
     MÉCANIQUEMENT dans la démonstration. Il n'apparaît PAS en S4.
   · Frame 0 = tension max : le gag est DÉJÀ en cours à t=0, jamais construit
     depuis un écran vide.
   · L'AGENT est un objet DÉJÀ codé dans l'épisode (rideau, gouffre, jauge…).
     La primitive ne dessine pas l'agent : elle se positionne par rapport à lui.
   · GARDE-FOU IMAGERIE : aucun accessoire guru (cigare, liasses, luxe) sauf
     ironie explicite — la retenue fait la crédibilité de la marque.

   USAGE dans un moteur :
     const MrD = MrDollar.init({svg:SVG, poses:NPOSE});
     // en S1 :
     MrD.gag(u, {primitive:'bumpInto', agent:{x:cut, y:1400},
                 reaction:'sonné', raccord:'point',
                 rest:{x:170, y:1430, h:232}});
     // ailleurs (il accompagne, petit) :
     MrD.show('point_soft', 152, 1440, 246, op, false);
     // en S4 : MrD.hide();
   ═══════════════════════════════════════════════════════════════════════════ */
(function (root) {
  'use strict';
  var NS = 'http://www.w3.org/2000/svg';
  var clamp = function (v, a, b) { return Math.max(a, Math.min(b, v)); };
  var lerp = function (a, b, f) { return a + (b - a) * clamp(f, 0, 1); };
  var eOut = function (f) { f = clamp(f, 0, 1); return 1 - (1 - f) * (1 - f); };
  var eIn = function (f) { f = clamp(f, 0, 1); return f * f; };
  var eInOut = function (f) { f = clamp(f, 0, 1); return f < .5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2; };
  // oscillation amortie : le rebond cartoon (jamais figé, deux harmoniques)
  var wob = function (u, f, d) { return Math.exp(-(d || 4) * u) * (Math.sin(u * f) + 0.4 * Math.sin(u * f * 2.1)); };

  var HIT = 0.75;   // durée de l'état de choc
  var RAC = 0.50;   // durée du raccord (il se relève / il montre)
  var HAND = 1.10;  // durée du passage de main (il rejoint sa place et reste petit)

  function MrDollar(cfg) {
    this.poses = cfg.poses || {};
    this.g = document.createElementNS(NS, 'g');
    this.g.setAttribute('opacity', '0');
    this.use = document.createElementNS(NS, 'use');
    this.g.appendChild(this.use);
    (cfg.svg || document.querySelector('svg')).appendChild(this.g);
    this.defaultPose = cfg.defaultPose || 'idle_soft';
  }

  /* Rendu bas niveau : ancrage aux PIEDS (x,y), rotation et squash autour des pieds. */
  MrDollar.prototype.draw = function (pose, x, y, h, op, flip, rot, sx, sy) {
    var name = this.poses[pose] ? pose : this.defaultPose;
    var P = this.poses[name];
    if (!P) return;
    pose = name;
    var s = h / P.h, fx = s * (sx == null ? 1 : sx) * (flip ? -1 : 1), fy = s * (sy == null ? 1 : sy);
    this.use.setAttributeNS('http://www.w3.org/1999/xlink', 'href', '#np_' + pose);
    this.use.setAttribute('href', '#np_' + pose);
    this.g.setAttribute('transform',
      'translate(' + x.toFixed(1) + ',' + y.toFixed(1) + ') rotate(' + (rot || 0).toFixed(1) + ') ' +
      'scale(' + fx.toFixed(4) + ',' + fy.toFixed(4) + ') translate(' + (-P.w / 2).toFixed(1) + ',' + (-P.h).toFixed(1) + ')');
    this.g.setAttribute('opacity', clamp(op == null ? 1 : op, 0, 1).toFixed(3));
  };
  MrDollar.prototype.show = function (pose, x, y, h, op, flip) { this.draw(pose, x, y, h, op, flip, 0, 1, 1); };
  MrDollar.prototype.hide = function () { this.g.setAttribute('opacity', '0'); };

  /* La RÉACTION choisit la pose et une inflexion (Bible VARIABLE C). */
  var REACT = {
    'sonné':      { pose: 'present_wide', tilt: 1.0,  bob: 1.0 },
    'surpris':    { pose: 'present_wide', tilt: 0.5,  bob: 0.6 },
    'résigné':    { pose: 'idle_soft',    tilt: 0.2,  bob: 0.2 },
    'inquiet':    { pose: 'point_soft',   tilt: 0.4,  bob: 0.5 },
    'impuissant': { pose: 'present_wide', tilt: 0.7,  bob: 0.7 },
    'curieux':    { pose: 'point_soft',   tilt: 0.2,  bob: 0.3 },
    'vexé':       { pose: 'idle_soft',    tilt: 0.0,  bob: 0.15 },
    'fier puis humilié': { pose: 'present_wide', tilt: 0.9, bob: 0.9 }
  };
  /* Le RACCORD : comment il passe la main (Bible VARIABLE F). */
  var RACCORD = {
    'point':   'point_soft',   // il se relève et pointe le "?"
    'ecarte':  'idle_soft',    // il s'écarte et laisse la place
    'sol':     'present_wide', // il reste au sol pendant que le "?" apparaît
    'sortie':  'idle_soft'     // il sort du cadre
  };

  /* ── FAMILLE 1 : IL SUBIT ─────────────────────────────────────────────────
     Chaque primitive rend l'état de CHOC à u=0 (déjà arrivé / en plein geste). */
  var P1 = {
    // il se cogne contre l'agent : nez écrasé, penché vers lui, il rebondit
    bumpInto: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: -78 - 16 * k, dy: 0, rot: -26 * k * r.tilt, sx: 1 + 0.16 * k, sy: 1 - 0.13 * k,
               bob: 9 * k * wob(u, 15, 5) * r.bob };
    },
    // il tombe dans/depuis l'agent : il est déjà bas, il remonte
    fall: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: -30, dy: 96 * k, rot: 18 * k * r.tilt, sx: 1 + 0.10 * k, sy: 1 - 0.10 * k,
               bob: 6 * k * wob(u, 12, 5) * r.bob };
    },
    // l'agent le percute : il est projeté à l'opposé, en l'air
    hitBy: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: -110 * k - 40, dy: -70 * k * eOut(1 - k + 0.001), rot: -34 * k * r.tilt,
               sx: 1 + 0.12 * k, sy: 1 - 0.08 * k, bob: 8 * k * wob(u, 14, 4.5) * r.bob };
    },
    // l'agent descend sur lui : il est aplati, il reprend sa forme
    crushedBy: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: -20, dy: 0, rot: 0, sx: 1 + 0.42 * k, sy: 1 - 0.46 * k,
               bob: 4 * k * wob(u, 16, 6) * r.bob };
    },
    // deux agents l'étirent : il est allongé horizontalement, il se rétracte
    stretchedBy: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: 0, dy: 0, rot: 0, sx: 1 + 0.55 * k, sy: 1 - 0.24 * k,
               bob: 5 * k * wob(u, 13, 5) * r.bob };
    },
    // il est aspiré/effacé par l'agent : il rétrécit vers lui puis revient
    vanishInto: function (u, a, r) {
      var k = clamp(1 - u / HIT, 0, 1);
      return { dx: -40 + 40 * k, dy: 0, rot: 12 * k * r.tilt, sx: 1 - 0.45 * k, sy: 1 - 0.45 * k,
               op: 1 - 0.35 * k, bob: 3 * k * wob(u, 11, 5) * r.bob };
    }
  };

  /* ── FAMILLES 2/3/4 : IL AGIT · IL EST · LE CONTRASTE ────────────────────
     Ici il ne subit pas : le mouvement vient de LUI (ou de son immobilité). */
  var P2 = {
    // il agit : signe, claquement, salto, sifflement
    gesture: function (u, type) {
      var c = clamp(u / 0.55, 0, 1);
      if (type === 'salto') return { pose: 'walk_wide', dx: 0, dy: -120 * Math.sin(Math.PI * c), rot: -360 * eInOut(c), sx: 1, sy: 1 };
      if (type === 'snap')  return { pose: 'point_soft', dx: 0, dy: 0, rot: -6 * Math.sin(u * 18) * (1 - c), sx: 1, sy: 1 };
      if (type === 'whistle') return { pose: 'idle_soft', dx: 0, dy: -5 * Math.abs(Math.sin(u * 5)), rot: 0, sx: 1, sy: 1 };
      return { pose: 'wave_wide', dx: 0, dy: 0, rot: 5 * Math.sin(u * 7) * (1 - 0.6 * c), sx: 1, sy: 1 }; // 'wave'
    },
    // il EST : boucle courte, calme. Seule, elle n'arrête pas le pouce (Bible) :
    // à n'utiliser QU'AVEC contrast().
    idle: function (u, type) {
      var b = 3 * Math.sin(u * 1.15) + 1.4 * Math.sin(u * 2.25);
      if (type === 'arms_crossed' || type === 'vexe') return { pose: 'wave_hip_soft', dx: 0, dy: b, rot: 0, sx: 1, sy: 1 };
      if (type === 'bored')  return { pose: 'idle_arms_down_soft', dx: 0, dy: b, rot: 2 * Math.sin(u * 0.6), sx: 1, sy: 1 };
      if (type === 'waits')  return { pose: 'wave_hip_wide', dx: 0, dy: b, rot: 0, sx: 1, sy: 1 };
      return { pose: 'idle_soft', dx: 0, dy: b, rot: 0, sx: 1, sy: 1 };
    },
    // il AGIT SUR l'agent de l'épisode : il tire / pousse / efface / soulève
    act: function (u, verb) {
      var c = eInOut(clamp(u / 0.9, 0, 1));
      if (verb === 'push')  return { pose: 'present_wide', dx: 46 * c, dy: 0, rot: 8 * c, sx: 1, sy: 1 };
      if (verb === 'erase') return { pose: 'point_soft', dx: 26 * Math.sin(u * 7), dy: 0, rot: 0, sx: 1, sy: 1 };
      if (verb === 'lift')  return { pose: 'present_wide', dx: 0, dy: -30 * c, rot: 0, sx: 1, sy: 1 };
      return { pose: 'point_soft', dx: -52 * c, dy: 0, rot: -8 * c, sx: 1, sy: 1 };   // 'pull'
    }
  };

  /* API PRINCIPALE — le gag d'ouverture de S1.
     spec = { primitive, agent:{x,y}, reaction, raccord, rest:{x,y,h}, h, flip,
              idle, verb, type }                                                */
  MrDollar.prototype.gag = function (u, spec) {
    spec = spec || {};
    var a = spec.agent || { x: 540, y: 1400 };
    var r = REACT[spec.reaction] || REACT['sonné'];
    var rest = spec.rest || { x: 170, y: a.y, h: 232 };
    var h0 = spec.h || 262;
    var st, pose;

    if (P1[spec.primitive]) {                       // FAMILLE 1 — il subit
      st = P1[spec.primitive](u, a, r);
      var rise = clamp((u - HIT) / RAC, 0, 1);
      pose = rise < 0.5 ? r.pose : (RACCORD[spec.raccord] || 'point_soft');
      st.rot = (st.rot || 0) * (1 - rise);           // il se redresse
      st.sx = lerp(st.sx == null ? 1 : st.sx, 1, rise);
      st.sy = lerp(st.sy == null ? 1 : st.sy, 1, rise);
    } else if (spec.primitive === 'contrast') {      // FAMILLE 4 — le contraste
      st = P2.idle(u, spec.idle || 'arms_crossed');  // lui calme, le chaos DERRIÈRE (l'épisode le dessine)
      pose = st.pose;
    } else if (spec.primitive === 'act') {           // FAMILLE 2 — il agit sur l'agent
      st = P2.act(u, spec.verb || 'pull'); pose = st.pose;
    } else if (spec.primitive === 'idle') {          // FAMILLE 3 — il est
      st = P2.idle(u, spec.type || 'bored'); pose = st.pose;
    } else {                                          // FAMILLE 2 — geste
      st = P2.gesture(u, spec.type || 'wave'); pose = st.pose;
    }

    // PASSAGE DE MAIN : il rejoint sa place et reste PETIT (il ne disparaît pas)
    var hand = eInOut(clamp((u - (HIT + RAC)) / HAND, 0, 1));
    if (hand > 0 && spec.raccord === 'sortie') {
      // variante : il sort réellement du cadre
      var x0 = a.x + (st.dx || 0), y0 = a.y + (st.dy || 0);
      this.draw(pose, lerp(x0, -240, hand), y0, h0, 1 - hand, spec.flip, st.rot, st.sx, st.sy);
      return;
    }
    var bx = a.x + (st.dx || 0), by = a.y + (st.dy || 0) + (st.bob || 0);
    var px = lerp(bx, rest.x, hand), py = lerp(by, rest.y, hand), ph = lerp(h0, rest.h, hand);
    if (hand > 0.85) { px += 4 * Math.sin(u * 1.2) + 2 * Math.sin(u * 2.3); }   // vie continue une fois posé
    this.draw(hand > 0.6 ? (RACCORD[spec.raccord] || 'idle_soft') : pose,
              px, py, ph, (st.op == null ? 1 : st.op) * (spec.op == null ? 1 : spec.op), spec.flip, st.rot, st.sx, st.sy);
  };

  root.MrDollar = {
    init: function (cfg) { return new MrDollar(cfg); },
    HIT: HIT, RAC: RAC, HAND: HAND,
    primitives: ['bumpInto', 'fall', 'hitBy', 'crushedBy', 'stretchedBy', 'vanishInto',
                 'gesture', 'idle', 'act', 'contrast']
  };
})(typeof window !== 'undefined' ? window : this);

    const NPOSE={"present_wide": {"w": 756, "h": 619}, "idle_soft": {"w": 449, "h": 618}, "point_soft": {"w": 608, "h": 618}, "walk_soft": {"w": 443, "h": 619}, "wave_hip_soft": {"w": 524, "h": 618}, "present_soft": {"w": 756, "h": 618}};

    // ═══ LE GRAPHE ═══ setup limpide à gauche, beau mouvement après l'instant de décision
    const CH_X0=140, CH_X1=950, DECX=560, CH_Y=1230;
    const CHART=[];
    for(let x=CH_X0;x<=CH_X1;x+=8){
      let y;
      if(x<DECX){const p=(x-CH_X0)/(DECX-CH_X0);
        y=CH_Y-34*Math.sin(x*0.021)*(1-0.55*p)-12*Math.sin(x*0.058)*(1-0.4*p);}
      else{const p=(x-DECX)/(CH_X1-DECX);
        y=CH_Y-262*eOut(p)-16*Math.sin(x*0.055)*(1-0.45*p);}
      CHART.push([x,y]);
    }
    const chartLine=mk('polyline',{fill:'none',stroke:INK,'stroke-width':7,'stroke-linejoin':'round','stroke-linecap':'round',opacity:0});
    const edge=mk('line',{stroke:INK,'stroke-width':9,'stroke-linecap':'round',opacity:0});     // le bord du rideau
    const decMark=mk('circle',{r:13,fill:YOU,opacity:0});                                        // l'instant de décision (TOI)
    const voidHint=mk('line',{stroke:DEAD,'stroke-width':5,'stroke-dasharray':'4 26','stroke-linecap':'round',opacity:0});
    function chartUpTo(cut,op){const pts=CHART.filter(p=>p[0]<=cut);
      chartLine.setAttribute('points',pts.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' '));setOp(chartLine,op);}
    function curtain(cut,op,y0,y1){edge.setAttribute('x1',cut);edge.setAttribute('x2',cut);
      edge.setAttribute('y1',y0||900);edge.setAttribute('y2',y1||1400);setOp(edge,op);}

    // ── mini-graphes réutilisables (S2 comparaison, S3 split, S4 les dix) ──
    const MINI=[]; for(let i=0;i<24;i++)MINI.push(mk('polyline',{fill:'none',stroke:INK,'stroke-width':4,'stroke-linejoin':'round','stroke-linecap':'round',opacity:0}));
    const MDOT=[]; for(let i=0;i<12;i++)MDOT.push(mk('circle',{r:8,fill:YOU,opacity:0}));
    let mi=0,md=0;
    function resetMini(){mi=0;md=0;}
    // seed : forme de setup identique pour tous ; after : varie (k)
    function miniPts(x,y,w,h,k,withAfter){
      const p=[];const n=26, half=Math.floor(n*0.55);
      for(let i=0;i<n;i++){
        const f=i/(n-1);
        if(i<=half){const q=i/half; p.push([x+w*f, y-h*0.22*Math.sin(q*7.1)*(1-0.5*q)]);}
        else{ if(!withAfter)break;
          const q=(i-half)/(n-1-half);
          const dir=(k%10===3)?1:-1;                                  // un seul court vraiment
          const amp=(k%10===3)?h*0.92:h*0.30*(0.4+((k*37)%7)/9);
          p.push([x+w*f, y-h*0.14-dir*amp*eOut(q)*(dir>0?1:0.55)]);}
      }
      return p;
    }
    function mini(x,y,w,h,k,withAfter,color,op){const e=MINI[mi++];if(!e)return;
      e.setAttribute('points',miniPts(x,y,w,h,k,withAfter).map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' '));
      e.setAttribute('stroke',color);setOp(e,op);}
    function mdot(x,y,op,color){const e=MDOT[md++];if(!e)return;e.setAttribute('cx',x.toFixed(1));e.setAttribute('cy',y.toFixed(1));e.setAttribute('fill',color||YOU);setOp(e,op);}
    function flushMini(){for(let i=mi;i<MINI.length;i++)setOp(MINI[i],0);for(let i=md;i<MDOT.length;i++)setOp(MDOT[i],0);}

    // ── le GESTE (S3) : le trait qui repasse (facile) / qui hésite au bord (dur) ──
    const traceDot=mk('circle',{r:15,fill:INK,opacity:0});
    const hoverDot=mk('circle',{r:15,fill:'none',stroke:YOU,'stroke-width':6,opacity:0});

    // ═══ NARRATEUR ═══ toujours en encre, petit, il montre — il ne porte pas la démonstration
    const MrD=MrDollar.init({svg:SVG,poses:NPOSE,defaultPose:'idle_soft'});
    function narrator(pose,x,yBottom,h,op,flip,rot){MrD.draw(pose,x,yBottom,h,op,flip,rot,1,1);}
    function noNarrator(){MrD.hide();}

    // ── QUESTION (§M15) — 1re ligne pleine dès la frame 0 ──
    const QLINES=['WHY WAS IT ONLY','OBVIOUS AFTERWARDS'];
    const FS=88,lineH=112,y0=200,qY=QLINES.map((s,li)=>y0+li*lineH);
    const qEls=QLINES.map((s,li)=>{const e=mk('text',{x:CX,y:qY[li],'text-anchor':'middle',fill:INK,'font-family':'Helvetica Neue, Arial, sans-serif','font-weight':800,'font-size':FS,'letter-spacing':'1',opacity:0});e.textContent=s;return e;});
    const QMY=y0+2*lineH+92,qMark=mk('text',{x:CX,y:QMY,'text-anchor':'middle',fill:INK,'font-family':'Helvetica Neue, Arial, sans-serif','font-weight':800,'font-size':200,opacity:0});qMark.textContent='?';
    qEls.forEach(e=>{const t=e.textContent,f=Math.min(FS,930/Math.max(1,t.length*0.66));e.setAttribute('font-size',f.toFixed(1));});
    function hideQ(){for(const e of qEls)setOp(e,0);setOp(qMark,0);}

    // ── ÉTIQUETTES (§M18) — putCap MESURE la largeur réelle ──
    function caption(sz){return mk('text',{'text-anchor':'middle','font-family':'Helvetica Neue, Arial, sans-serif','font-weight':(sz>44?800:700),'font-size':(sz||38),'data-fs':(sz||38),'letter-spacing':'1.5',opacity:0});}
    const capA=caption(42),capB=caption(42),capC=caption(42),capD=caption(38),capE=caption(38),capF=caption(38);
    function putCap(el,txt,cx,y,color,op){
      const MARGIN=70, MAXW=1080-2*MARGIN;
      if(el.__cap!==txt){ el.__cap=txt; el.textContent=txt;
        const nom=+el.getAttribute('data-fs')||+el.getAttribute('font-size')||38;
        el.setAttribute('font-size',nom);
        let w=el.getComputedTextLength()||0;
        if(!w) w=txt.length*nom*0.72;
        if(w>MAXW){ const fs=Math.max(18,nom*MAXW/w); el.setAttribute('font-size',fs.toFixed(1)); w=el.getComputedTextLength()||txt.length*fs*0.72; }
        el.__hw=w/2;
      }
      const x=clamp(+cx, MARGIN+el.__hw, 1080-MARGIN-el.__hw);
      el.setAttribute('x',x.toFixed(1));el.setAttribute('y',y);el.setAttribute('fill',color);setOp(el,op);}
    function hideCaps(){for(const e of [capA,capB,capC,capD,capE,capF])setOp(e,0);}
    function hideAll(){setOp(chartLine,0);setOp(edge,0);setOp(decMark,0);setOp(voidHint,0);setOp(traceDot,0);setOp(hoverDot,0);}

    // ═══ S1 — LE GRAPHE ÉVIDENT, ET LE RIDEAU DÉJÀ ENTRÉ ═══
    // Verbe visuel : l'effacement qui avance (le rideau mange l'après).
    function s1(lf,t,s){
      const u=t-s; hideCaps(); resetMini(); hideAll();
      const gf=clamp(1-(lf-0.86)/0.09,0,1);
      for(let k=0;k<qEls.length;k++){const qt=(k===0?0.18:u-(0.1+k*0.28)),ap=clamp(qt/0.18,0,1),sc=0.7+0.3*backOut(ap);setOp(qEls[k],ap*gf);qEls[k].setAttribute('transform',`translate(${(CX*(1-sc)).toFixed(2)} ${(qY[k]*(1-sc)).toFixed(2)}) scale(${sc.toFixed(3)})`);}
      const qm=u-0.9,qap=clamp(qm/0.2,0,1),qsc=0.6+0.4*backOut(qap);setOp(qMark,qap*gf*clamp(1-(u-4.2)/1.2,0,1));qMark.setAttribute('transform',`translate(${(CX*(1-qsc)).toFixed(2)} ${(QMY*(1-qsc)).toFixed(2)}) scale(${qsc.toFixed(3)})`);
      // ÉMOTION FRAME 0 : le graphe complet est là, ET le rideau est DÉJÀ entré. Rien ne se construit.
      const cut=lerp(838,690,eInOut(clamp(u/9,0,1)))+7*Math.sin(u*0.9)+3*Math.sin(u*1.9);
      chartUpTo(cut,1);
      curtain(cut,1,880,1420);
      decMark.setAttribute('cx',DECX);decMark.setAttribute('cy',CHART.find(p=>p[0]>=DECX)[1]);setOp(decMark,clamp((u-2.6)/0.8,0,1)*0.9);
      putCap(capA,'YESTERDAY — THE TRADE IS OBVIOUS',CX,830,INK,clamp((u-1.9)/0.7,0,1)*gf);
      putCap(capC,'THE CHART ENDS HERE',cut,1470,DEAD,clamp((u-3.4)/0.8,0,1)*gf);
      // ── GAG DE HOOK (Bible II bis) — VERBE : se cogner · AGENT : le rideau · RÉACTION : sonné puis il montre
      //    TEMPS : EN PLEIN GESTE dès la frame 0 (il est déjà écrasé contre le rideau, aucune construction).
      //    RACCORD : il se relève, pointe le "?", puis s'écarte et laisse la place au schéma. ~1,5 s.
      // PRIMITIVE : bumpInto — AGENT : le rideau qui masque la droite (Bible : « le bord du
      // graphe → il se cogne au rideau »). Frame 0 = déjà écrasé contre lui. Puis il se relève,
      // pointe le "?", et PASSE LA MAIN sans disparaître (il reste petit pour accompagner).
      if(u<4.0){
        MrD.gag(u, {primitive:'bumpInto', agent:{x:cut, y:1430}, reaction:'sonné',
                    raccord:'point', rest:{x:215, y:1430, h:236}, h:262, op:gf});
      }else{                                        // il s'en va : la démonstration reste seule
        const o=clamp((u-4.0)/1.2,0,1);
        MrD.draw('walk_soft', lerp(215,-170,eInOut(o)), 1430, 236, (1-o)*gf, true, 0,1,1);
      }
      flushMini();
    }

    // ═══ S2 — LE RIDEAU FERMÉ : le setup seul, et le VIDE à sa droite ═══
    // Verbe visuel : le vide qui s'ouvre (ce que le direct n'a jamais).
    function s2(lf,t,s){
      const u=t-s; hideQ(); hideCaps(); resetMini(); hideAll();
      const cut=lerp(690,DECX,eInOut(clamp(u/2,0,1)));
      chartUpTo(cut,1);
      curtain(cut,1,880,1420);
      decMark.setAttribute('cx',DECX);decMark.setAttribute('cy',CHART.find(p=>p[0]>=DECX)[1]);setOp(decMark,1);
      // le vide respire (vie continue : position, deux harmoniques)
      const vy=1180+16*Math.sin(u*0.85)+7*Math.sin(u*1.75);
      voidHint.setAttribute('x1',cut+40);voidHint.setAttribute('x2',980);voidHint.setAttribute('y1',vy);voidHint.setAttribute('y2',vy);
      setOp(voidHint,clamp((u-1.4)/0.8,0,1)*0.85);
      putCap(capA,'THE MOMENT OF DECISION',DECX,1470,YOU,clamp((u-0.8)/0.7,0,1));
      putCap(capC,'NOTHING TO READ YET',800,1120,DEAD,clamp((u-2.0)/0.8,0,1));
      // comparaison : le graphe complet en petit, au-dessus
      const cap2=clamp((u-2.6)/0.9,0,1);
      mini(200,760,300,120,3,true,DEAD,cap2*0.8);
      mini(640,760,300,120,3,false,INK,cap2);
      putCap(capD,'REVIEWED',350,830,DEAD,cap2);
      putCap(capE,'LIVE',790,830,INK,cap2);
      putCap(capB,'THE LIVE CHART NEVER HAS THE AFTER',CX,610,INK,clamp((u-3.6)/0.8,0,1));
      // BEAT : il entre en marchant, s'arrête, DÉSIGNE le vide, puis ressort. Une apparition, pas un décor.
      const inW=eInOut(clamp((u-1.3)/1.0,0,1)), outW=eInOut(clamp((u-6.4)/1.2,0,1));
      if(u>1.3 && outW<1){
        const stop=330, alive=(inW>0.95&&outW<0.05)?(4*Math.sin(u*1.2)+2*Math.sin(u*2.3)):0;
        const nx=lerp(lerp(-150,stop,inW),-170,outW)+alive;
        MrD.draw(inW<0.95?'walk_soft':'point_soft', nx, 1440, 242, 1-outW, false, 0,1,1);
      }else{ MrD.hide(); }
      flushMini();
    }

    // ═══ S3 — DEUX EXERCICES : expliquer une forme visible vs s'engager dans le vide ═══
    // Verbe visuel : la comparaison de deux gestes (l'un glisse, l'autre reste suspendu).
    function s3(lf,t,s){
      const u=t-s; hideQ(); hideCaps(); resetMini(); hideAll();
      const LY=980, RY=1330, W=360, H=150;
      // GAUCHE — EXPLAINING : la forme est déjà là, le geste la repasse sans effort
      mini(120,LY,W,H,3,true,INK,1);
      const gp=(u*0.42)%1, gx=120+W*gp, gy=LY-H*0.14-H*0.72*eOut(clamp((gp-0.55)/0.45,0,1));
      traceDot.setAttribute('cx',gx.toFixed(1));traceDot.setAttribute('cy',(gp<0.55?LY-H*0.2*Math.sin(gp*12):gy).toFixed(1));
      setOp(traceDot,clamp((u-0.4)/0.6,0,1));
      putCap(capE,'EXPLAINING WHAT YOU SEE',300,LY+96,DEAD,clamp((u-0.8)/0.7,0,1));
      // DROITE — COMMITTING : le graphe s'arrête, le geste hésite au-dessus du vide
      mini(120,RY,W,H,3,false,INK,1);
      const hx=120+W*0.55+26+18*Math.sin(u*1.25)+8*Math.sin(u*2.35), hy=RY-H*0.26+14*Math.sin(u*0.95)+6*Math.sin(u*2.1);
      hoverDot.setAttribute('cx',hx.toFixed(1));hoverDot.setAttribute('cy',hy.toFixed(1));
      setOp(hoverDot,clamp((u-2.0)/0.7,0,1));
      curtain(120+W*0.55,clamp((u-1.8)/0.6,0,1),RY-H,RY+30);
      putCap(capF,'COMMITTING INTO THE VOID',300,RY+96,YOU,clamp((u-2.4)/0.7,0,1));
      putCap(capB,'READING THE PATTERN WAS NEVER THE HARD PART',CX,700,INK,clamp((u-3.4)/0.8,0,1));
      // BEAT 1 : il pointe la forme DÉJÀ tracée (l'exercice facile).  BEAT 2 : bras croisés devant le vide.
      if(u<3.5){
        MrD.draw('point_soft', 886+12*Math.sin(u*1.25)+5*Math.sin(u*2.3), 1330, 190,
                 clamp((u-0.9)/0.6,0,1)*(1-clamp((u-3.1)/0.4,0,1)), false, 0,1,1);
      }else{
        MrD.draw('wave_hip_soft', 906+5*Math.sin(u*1.05)+3*Math.sin(u*2.15), 1330, 196,
                 clamp((u-3.7)/0.6,0,1)*(1-clamp((u-9.0)/1.0,0,1)), true, 0,1,1);
      }
      flushMini();
    }

    // ═══ S4 — DIX SETUPS : différents rideau ouvert, IDENTIQUES rideau fermé ═══
    // Verbe visuel : l'uniformisation (les dix suites disparaissent, il ne reste qu'une seule forme).
    // NARRATEUR ABSENT : la tension doit frapper sans accompagnement.
    function s4(lf,t,s){
      const u=t-s; hideQ(); hideCaps(); resetMini(); hideAll(); noNarrator();
      const W=168, H=104, X0=110, Y0=1000, GAP=16;
      const closed=clamp((u-1.5)/1.1,0,1);          // le rideau se ferme sur les dix
      for(let k=0;k<10;k++){
        const cx=X0+(k%5)*(W+GAP), cy=Y0+Math.floor(k/5)*(H+150);
        const win=(k===3);
        const col=win?YOU:DEAD;
        mini(cx,cy,W,H,k,true,col,(1-closed)*(win?1:0.75));
        mini(cx,cy,W,H,k,false,closed>0.02?(win?YOU:DEAD):col,closed*(win?1:0.8));
        if(closed>0.5)mdot(cx+W*0.56,cy-H*0.16,closed*0.9,win?YOU:DEAD);
      }
      putCap(capA,'OPEN — ONE RAN, NINE DID NOT',CX,880,DEAD,clamp(1-(u-1.2)/0.6,0,1));
      putCap(capB,'CLOSED — ALL TEN LOOK THE SAME',CX,880,INK,closed);
      // « be more decisive » : la décision les prend TOUS
      const dec=clamp((u-3.0)/1.0,0,1);
      putCap(capC,'BE MORE DECISIVE',CX,1560,YOU,dec*clamp(1-(u-6.5)/1.0,0,1));
      putCap(capD,'THE WINNER LOOKS EXACTLY LIKE THE NINE',CX,1630,INK,clamp((u-4.2)/0.9,0,1));
      flushMini();
    }

    // ═══ S5 — DÉCHARGE : le rideau devient un OUTIL qu'on tire soi-même ═══
    // Verbe visuel : le geste volontaire (tu tires le rideau, tu poses la question).
    function s5(lf,t,s){
      const u=t-s; hideQ(); hideCaps(); resetMini(); hideAll();
      const pull=eInOut(clamp(u/2,0,1));
      const cut=lerp(950,DECX,pull);
      chartUpTo(cut,1);
      curtain(cut,1,880,1420);
      decMark.setAttribute('cx',DECX);decMark.setAttribute('cy',CHART.find(p=>p[0]>=DECX)[1]);setOp(decMark,1);
      // la main qui tire : un repère teal sur le bord, il ne bouge plus une fois posé
      const grip=clamp((u-0.2)/1.6,0,1);
      hoverDot.setAttribute('cx',cut.toFixed(1));hoverDot.setAttribute('cy',(950+(u<2?9*Math.sin(u*2.2):0)).toFixed(1));setOp(hoverDot,grip);
      putCap(capA,'COVER THE RIGHT SIDE',cut,830,YOU,clamp((u-0.6)/0.7,0,1));
      putCap(capC,'WHAT DID I ACTUALLY HAVE?',CX,1470,INK,clamp((u-2.0)/0.8,0,1));
      // le verdict, à côté (jamais par-dessus le graphe)
      const v=clamp((u-2.8)/0.9,0,1);
      putCap(capD,'SAME AS NINE THAT FAILED',CX,1550,DEAD,v);
      putCap(capB,'THEN NOTHING WAS MISSED',CX,700,INK,clamp((u-3.4)/0.9,0,1));
      // C'EST LUI QUI TIRE LE RIDEAU : il l'accompagne pendant qu'il se ferme, puis il se fige (image finale).
      const grab=clamp((u-0.15)/0.5,0,1), frozen=clamp((u-3.6)/0.6,0,1);
      const jit=(1-frozen)*(4*Math.sin(u*1.15)+2*Math.sin(u*2.25));
      MrD.draw(u<2.6?'point_soft':'idle_soft', cut+96+jit, 1440, 238, grab, true, 0,1,1);
      flushMini();
    }

    const RENDER={s1,s2,s3,s4,s5};const SCENEFN=SPEC.map(s=>RENDER[s.id]||s1);
    const clock={t:0};
    function sceneAt(t){let i=0;for(let k=0;k<SC.length;k++){if(t>=SC[k].s-1e-6)i=k;}return Math.min(i,SCENEFN.length-1);}
    function render(){const t=clock.t;const i=sceneAt(t),lf=clamp((t-SC[i].s)/SC[i].d,0,1);SCENEFN[i](lf,t,SC[i].s);}
    const tl=gsap.timeline({paused:true});
    tl.to(clock,{t:TOTAL,duration:TOTAL,ease:'none',onUpdate:render},0);
    tl.to(SVG,{opacity:1,duration:0.001},TOTAL-0.001);
    window.__timelines=window.__timelines||{};window.__timelines['main']=tl;
  </script>
</body>
</html>
