<!doctype html>
<html lang="en" data-resolution="portrait" data-fps="30">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=1080, height=1920" />
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>:root{--paper:#F2EFE7}*{margin:0;padding:0;box-sizing:border-box}html,body{width:1080px;height:1920px;overflow:hidden;background:var(--paper)}#stage{position:absolute;inset:0}svg{position:absolute;inset:0;width:1080px;height:1920px}</style>
</head>
<body>
  <!-- L30 « THE CONFIDENCE THAT LIES » — TOI = jauges teal. Fusil de Tchekhov = la JAUGE DE CONFIANCE (teal, gonflée à craquer) : elle
       arme la perte, et se résout en S5 (drapeau jaune, taille tenue). S1 : émotion frame 0 = levier TENSION — la jauge de confiance est
       DÉJÀ pleine à ras bord, des gouttes s'échappent du haut (au bord du débordement), la série de wins déjà alignée : rien ne se
       construit, la tension est entière dès t=0. S2 : DIVERGENCE — l'edge (petite jauge STABLE) et la confiance (énorme) ont divergé ;
       une pièce fil-de-fer tourne (le prochain trade reste 50/50) ; le marché (bloc neutre) n'a aucune mémoire. S3 : LA POUSSÉE — la
       confiance POUSSE la jauge de taille vers le haut (taille MAX) pendant que le doute s'effondre et se délave (doute MIN), au même
       instant. S4 : LA DÉCHARGE — un mouvement de marché ORDINAIRE (petite flèche encre) fait tourner le trade, mais comme la position
       était géante, la perte est énorme : la grosse jauge se délave d'un bloc gris, la série entière effacée ; à côté, à taille normale,
       le même mouvement n'est qu'une éraflure. S5 : DÉCHARGE du fusil — la confiance regonfle, mais un DRAPEAU JAUNE se lève et la taille
       RESTE stable, alignée sur l'edge constant. Doctrine : aucun chiffre ; gris = perte/délavage (pas de rouge) ; pas de brun ; le
       drapeau jaune = fanion teal-ocre d'alerte (WARN), jamais le brun-camp ; la pièce = fil-de-fer ; TOI = jauge teal ; bas du cadre vide. -->
  <div id="stage" class="clip" data-start="0" data-duration="__TOTAL__" data-track-index="1"><svg id="svg" viewBox="0 0 1080 1920"></svg></div>
  <script>
    const TOTAL=__TOTAL__, SC=__SCENES__, SPEC=__SPEC__;
    const NS='http://www.w3.org/2000/svg', SVG=document.getElementById('svg');
    const YOU='#1E5F6E', INK='#20242A', PAPER='#F2EFE7', DEAD='#474D50', WARN='#C9A94A';
    const CX=540;
    function mk(t,a,p){const e=document.createElementNS(NS,t);for(const k in(a||{}))e.setAttribute(k,a[k]);(p||SVG).appendChild(e);return e;}
    const clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),lerp=(a,b,f)=>a+(b-a)*clamp(f,0,1),eIn=f=>f*f,eOut=f=>1-(1-f)*(1-f),eInOut=f=>f<.5?2*f*f:1-Math.pow(-2*f+2,2)/2;
    const backOut=(p,s)=>{s=(s==null?1.9:s);const q=clamp(p,0,1)-1;return 1+(s+1)*q*q*q+s*q*q;};
    const setOp=(el,o)=>el.setAttribute('opacity',clamp(o,0,1).toFixed(3));
    const hx=c=>[parseInt(c.slice(1,3),16),parseInt(c.slice(3,5),16),parseInt(c.slice(5,7),16)];
    const mix=(a,b,f)=>{const A=hx(a),B=hx(b);return `rgb(${A.map((v,i)=>Math.round(lerp(v,B[i],f))).join(',')})`;};

    // ── JAUGES (bar générique) : le haut BOUGE (déplacement de position, pas d'opacité). ──
    const confBar=mk('rect',{rx:6,fill:YOU,opacity:0}), confBase=mk('line',{stroke:INK,'stroke-width':6,opacity:0});
    const sizeBar=mk('rect',{rx:6,fill:YOU,opacity:0}), sizeBase=mk('line',{stroke:INK,'stroke-width':6,opacity:0});
    const edgeBar=mk('rect',{rx:5,fill:YOU,opacity:0}), edgeBase=mk('line',{stroke:INK,'stroke-width':6,opacity:0});
    const doubtBar=mk('rect',{rx:5,fill:YOU,opacity:0}), doubtBase=mk('line',{stroke:INK,'stroke-width':6,opacity:0});
    const scratchBar=mk('rect',{rx:5,fill:YOU,opacity:0}), scratchBase=mk('line',{stroke:INK,'stroke-width':6,opacity:0});
    const lossBlock=mk('rect',{rx:6,fill:DEAD,opacity:0});           // le bloc gris de la série effacée
    const scratchNick=mk('rect',{rx:3,fill:DEAD,opacity:0});         // la minuscule éraflure à taille normale
    function bar(el,cx,w,baseY,h,wash,op,dx){dx=dx||0;h=Math.max(3,h);
      el.setAttribute('x',(cx-w/2+dx).toFixed(1));el.setAttribute('y',(baseY-h).toFixed(1));
      el.setAttribute('width',w);el.setAttribute('height',h.toFixed(1));el.setAttribute('fill',mix(YOU,DEAD,wash||0));setOp(el,op);}
    function baseLine(el,cx,w,baseY,op){el.setAttribute('x1',(cx-w/2-14).toFixed(1));el.setAttribute('x2',(cx+w/2+14).toFixed(1));
      el.setAttribute('y1',(baseY+8).toFixed(1));el.setAttribute('y2',(baseY+8).toFixed(1));setOp(el,op);}

    // ── LA SÉRIE DE WINS (coches teal) + LES GOUTTES au ras de la jauge (débordement) ──
    const WINS=[]; for(let i=0;i<8;i++)WINS.push(mk('polyline',{fill:'none',stroke:YOU,'stroke-width':10,'stroke-linejoin':'round','stroke-linecap':'round',opacity:0}));
    const drops=[]; for(let i=0;i<4;i++)drops.push(mk('circle',{r:7,fill:YOU,opacity:0}));
    function drawCheck(el,cx,cy,sc,color,op){const p=[[-20,-2],[-6,14],[22,-18]].map(([x,y])=>[(cx+x*sc).toFixed(1),(cy+y*sc).toFixed(1)]);
      el.setAttribute('points',p.map(q=>q.join(',')).join(' '));el.setAttribute('stroke',color);setOp(el,op);}

    // ── LA PIÈCE (fil-de-fer) qui tourne : le prochain trade reste 50/50 ──
    const coin=mk('ellipse',{fill:'none',stroke:INK,'stroke-width':6,opacity:0}), coinMark=mk('circle',{r:9,fill:INK,opacity:0});
    // ── LE MARCHÉ : bloc neutre, indifférent, qui dérive ──
    const market=mk('rect',{rx:6,fill:DEAD,'fill-opacity':0.22,stroke:INK,'stroke-width':5,opacity:0});
    // ── LA POUSSÉE (flèche) confiance → taille ; LE MOUVEMENT ORDINAIRE du marché ──
    const pushLine=mk('line',{stroke:INK,'stroke-width':9,'stroke-linecap':'round',opacity:0}), pushHead=mk('polygon',{fill:INK,opacity:0});
    const mktLine=mk('line',{stroke:INK,'stroke-width':7,'stroke-linecap':'round',opacity:0}), mktHead=mk('polygon',{fill:INK,opacity:0});
    function drawArrow(lineEl,headEl,x1,y1,x2,y2,op){lineEl.setAttribute('x1',x1.toFixed(1));lineEl.setAttribute('y1',y1.toFixed(1));
      lineEl.setAttribute('x2',x2.toFixed(1));lineEl.setAttribute('y2',y2.toFixed(1));setOp(lineEl,op);
      const ang=Math.atan2(y2-y1,x2-x1),L=24,wg=0.5;
      const p=[[x2,y2],[x2-L*Math.cos(ang-wg),y2-L*Math.sin(ang-wg)],[x2-L*Math.cos(ang+wg),y2-L*Math.sin(ang+wg)]];
      headEl.setAttribute('points',p.map(q=>[q[0].toFixed(1),q[1].toFixed(1)].join(',')).join(' '));setOp(headEl,op);}
    // ── LE DRAPEAU JAUNE (fanion d'alerte, teal-ocre — jamais brun-camp) ──
    const flagPole=mk('line',{stroke:INK,'stroke-width':7,'stroke-linecap':'round',opacity:0}), flagPenn=mk('polygon',{fill:WARN,opacity:0});

    // ── QUESTION (§M15) — 1re ligne pleine dès la frame 0 ──
    const QLINES=['WHY IS FEELING SURE','SO DANGEROUS'];
    const FS=68,lineH=94,y0=210,qY=QLINES.map((s,li)=>y0+li*lineH);
    const qEls=QLINES.map((s,li)=>{const e=mk('text',{x:CX,y:qY[li],'text-anchor':'middle',fill:INK,'font-family':'Helvetica Neue, Arial, sans-serif','font-weight':800,'font-size':FS,'letter-spacing':'1',opacity:0});e.textContent=s;return e;});
    const QMY=y0+2*lineH+92,qMark=mk('text',{x:CX,y:QMY,'text-anchor':'middle',fill:INK,'font-family':'Helvetica Neue, Arial, sans-serif','font-weight':800,'font-size':150,opacity:0});qMark.textContent='?';
    qEls.forEach(e=>{const t=e.textContent,f=Math.min(FS,930/Math.max(1,t.length*0.66));e.setAttribute('font-size',f.toFixed(1));});
    function hideQ(){for(const e of qEls)setOp(e,0);setOp(qMark,0);}

    // ── ÉTIQUETTES (§M18) — putCap réduit la police et clampe la position (jamais de débordement) ──
    function caption(sz){return mk('text',{'text-anchor':'middle','font-family':'Helvetica Neue, Arial, sans-serif','font-weight':(sz>44?800:700),'font-size':(sz||38),'data-fs':(sz||38),'letter-spacing':'1.5',opacity:0});}
    const capA=caption(40),capB=caption(44),capC=caption(38),capD=caption(36),capE=caption(36),capF=caption(36);
    function putCap(el,txt,cx,y,color,op){
      // MESURE réelle (getComputedTextLength inclut le letter-spacing, ignoré par l'ancienne
      // estimation ×0.66 — cause du débordement live). Réduit la police pour tenir dans la zone
      // sûre, puis borne le centre par la demi-largeur MESURÉE : plus de coupe au bord.
      const MARGIN=70, MAXW=1080-2*MARGIN;
      if(el.__cap!==txt){ el.__cap=txt; el.textContent=txt;
        const nom=+el.getAttribute('data-fs')||+el.getAttribute('font-size')||38;
        el.setAttribute('font-size',nom);
        let w=el.getComputedTextLength()||0;
        if(!w) w=txt.length*nom*0.72;
        if(w>MAXW){ const fs=Math.max(18,nom*MAXW/w); el.setAttribute('font-size',fs.toFixed(1)); w=el.getComputedTextLength()||txt.length*fs*0.72; }
        el.__hw=w/2;
      }
      const x=clamp(+cx, MARGIN+el.__hw, 1080-MARGIN-el.__hw);
      el.setAttribute('x',x.toFixed(1));el.setAttribute('y',y);el.setAttribute('fill',color);setOp(el,op);}
    function hideCaps(){for(const e of [capA,capB,capC,capD,capE,capF])setOp(e,0);}

    // masque tout le dynamique (coupe franche : chaque scène ré-affiche SES objets, déjà pleins)
    function hideDyn(){for(const e of [confBar,confBase,sizeBar,sizeBase,edgeBar,edgeBase,doubtBar,doubtBase,
      scratchBar,scratchBase,lossBlock,scratchNick,coin,coinMark,market,pushLine,pushHead,mktLine,mktHead,flagPole,flagPenn])setOp(e,0);
      for(const e of WINS)setOp(e,0);for(const e of drops)setOp(e,0);hideCaps();}

    // ═══ S1 — LA CONFIANCE PLEINE À CRAQUER (émotion frame 0 : TENSION, au bord du débordement) ═══
    // Verbe visuel : le gonflement / l'accumulation (la série alignée, la jauge gorgée qui déborde).
    function s1(lf,t,s){
      const u=t-s; hideDyn();
      const gf=clamp(1-(lf-0.85)/0.10,0,1);
      for(let k=0;k<qEls.length;k++){const qt=(k===0?0.18:u-(0.1+k*0.30)),ap=clamp(qt/0.18,0,1),sc=0.7+0.3*backOut(ap);setOp(qEls[k],ap*gf);qEls[k].setAttribute('transform',`translate(${(CX*(1-sc)).toFixed(2)} ${(qY[k]*(1-sc)).toFixed(2)}) scale(${sc.toFixed(3)})`);}
      const qm=u-0.95,qap=clamp(qm/0.2,0,1),qsc=0.6+0.4*backOut(qap);setOp(qMark,qap*gf);qMark.setAttribute('transform',`translate(${(CX*(1-qsc)).toFixed(2)} ${(QMY*(1-qsc)).toFixed(2)}) scale(${qsc.toFixed(3)})`);
      // ── ÉMOTION FRAME 0 : la jauge est DÉJÀ pleine à ras bord, gorgée ; elle respire fort (deux harmoniques). ──
      const cx=540, base=1360, w=170;
      const h=498+22*Math.sin(u*1.15)+12*Math.sin(u*2.05);
      const dx=6*Math.sin(u*0.85)+3*Math.sin(u*1.70);
      bar(confBar,cx,w,base,h,0,1,dx); baseLine(confBase,cx,w,base,1);
      const top=base-h;                                                   // les gouttes s'échappent du haut (débordement)
      for(let i=0;i<4;i++){const ph=i*1.6;
        drops[i].setAttribute('cx',(cx-57+i*38+dx+4*Math.sin(u*2.3+ph)).toFixed(1));
        drops[i].setAttribute('cy',(top-6-14*Math.abs(Math.sin(u*1.9+ph))-5*Math.sin(u*3.1+ph)).toFixed(1));setOp(drops[i],1);}
      for(let i=0;i<6;i++){const wy=650+10*Math.sin(u*1.7+i*0.7)+4*Math.sin(u*2.9+i*0.5);   // la série de wins, vivante
        drawCheck(WINS[i],252+i*116,wy,1,YOU,1);}
      putCap(capA,'CONFIDENCE',cx,base+64,YOU,1);
      putCap(capC,'YOUR WINS',540,584,YOU,1);
    }

    // ═══ S2 — LA DIVERGENCE : l'edge stable, la confiance énorme ; la pièce 50/50 ; le marché sans mémoire ═══
    // Verbe visuel : la comparaison A/B (deux jauges qui ont DIVERGÉ) + la pièce qui tourne.
    function s2(lf,t,s){
      const u=t-s; hideQ(); hideDyn();
      // EDGE (petite, STABLE) — à peine vivante, elle ne grandit pas
      const ex=170, ebase=1300, ew=118, eh=150+4*Math.sin(u*1.3)+2*Math.sin(u*2.4);
      bar(edgeBar,ex,ew,ebase,eh,0,1,5*Math.sin(u*0.9)+2.5*Math.sin(u*1.9)); baseLine(edgeBase,ex,ew,ebase,1);
      putCap(capC,'YOUR EDGE',ex,ebase+64,YOU,1);
      putCap(capE,'UNCHANGED',ex,ebase+110,DEAD,clamp((u-2.4)/0.7,0,1));
      // CONFIANCE (énorme) — elle a divergé de l'edge
      const cx=470, cbase=1360, cw=168, ch=500+18*Math.sin(u*1.05)+10*Math.sin(u*1.95);
      bar(confBar,cx,cw,cbase,ch,0,1,6*Math.sin(u*0.80)+3*Math.sin(u*1.65)); baseLine(confBase,cx,cw,cbase,1);
      putCap(capA,'CONFIDENCE',cx,cbase+64,YOU,1);
      // LA PIÈCE fil-de-fer qui tourne (haut-droite) : toujours 50/50
      const coinCx=852, coinCy=770+13*Math.sin(u*1.4)+5*Math.sin(u*2.5);
      const rx=Math.max(4,46*Math.abs(Math.cos(u*3.0)));
      coin.setAttribute('cx',coinCx);coin.setAttribute('cy',coinCy.toFixed(1));coin.setAttribute('rx',rx.toFixed(1));coin.setAttribute('ry',46);setOp(coin,1);
      coinMark.setAttribute('cx',coinCx);coinMark.setAttribute('cy',coinCy.toFixed(1));setOp(coinMark,rx>28?0.9:0);
      putCap(capD,'NEXT TRADE — STILL A COIN FLIP',852,676,INK,clamp((u-1.2)/0.6,0,1));
      // LE MARCHÉ : bloc neutre qui dérive, indifférent à la série (placé à droite, dégagé de la jauge)
      const mx=852+11*Math.sin(u*0.7)+5*Math.sin(u*1.5), my=1054+9*Math.sin(u*1.1)+4*Math.sin(u*2.2);
      market.setAttribute('x',(mx-92).toFixed(1));market.setAttribute('y',(my-56).toFixed(1));market.setAttribute('width',184);market.setAttribute('height',112);setOp(market,1);
      putCap(capF,'MARKET — NO MEMORY',900,my+92,DEAD,clamp((u-1.8)/0.6,0,1));
      putCap(capB,'CONFIDENCE GREW — YOUR EDGE DID NOT',CX,596,INK,clamp((u-3.0)/0.7,0,1));
    }

    // ═══ S3 — LA POUSSÉE : la confiance pousse la TAILLE au sommet, pendant que le doute s'effondre ═══
    // Verbe visuel : la poussée (une force soulève la taille) + l'effondrement délavé du doute.
    function s3(lf,t,s){
      const u=t-s; hideQ(); hideDyn();
      // CONFIANCE (gauche) : la source
      const cx=228, cbase=1360, cw=150, ch=498+18*Math.sin(u*1.1)+10*Math.sin(u*1.95);
      const cdx=5*Math.sin(u*0.85)+2.5*Math.sin(u*1.7);
      bar(confBar,cx,cw,cbase,ch,0,1,cdx); baseLine(confBase,cx,cw,cbase,1);
      putCap(capA,'CONFIDENCE',cx,cbase+64,YOU,1);
      // TAILLE (centre) : poussée vers le haut, elle grossit
      const grow=eOut(clamp(u/2.4,0,1));
      const sx=548, sbase=1360, sw=182, sh=(150+430*grow)+16*Math.sin(u*1.25)+9*Math.sin(u*2.15);
      const sdx=6*Math.sin(u*0.95)+3*Math.sin(u*1.8);
      bar(sizeBar,sx,sw,sbase,sh,0,1,sdx); baseLine(sizeBase,sx,sw,sbase,1);
      putCap(capC,'POSITION SIZE',sx,sbase+64,YOU,1);
      // la flèche de poussée : de la confiance vers le bas de la taille
      drawArrow(pushLine,pushHead, cx+cw/2+8, cbase-ch*0.55, sx-sw/2-8, sbase-sh*0.55, clamp((u-0.3)/0.6,0,1));
      // DOUTE (droite) : s'effondre et se délave (gris) — au plus bas
      const sink=eInOut(clamp(u/2.6,0,1));
      const dx3=858, dbase=1360, dw=118, dh=(300*(1-0.82*sink))+8*Math.sin(u*1.4)+4*Math.sin(u*2.3);
      bar(doubtBar,dx3,dw,dbase,dh,0.20+0.72*sink,1,4*Math.sin(u*0.8)+2*Math.sin(u*1.6)); baseLine(doubtBase,dx3,dw,dbase,1);
      putCap(capD,'DOUBT',dx3,dbase+64,DEAD,1);
      putCap(capE,'AT ITS LOWEST',dx3,dbase-dh-34,DEAD,clamp((u-2.2)/0.7,0,1));
      putCap(capB,'BIGGEST SIZE — LEAST DOUBT — SAME MOMENT',CX,592,INK,clamp((u-2.8)/0.7,0,1));
    }

    // ═══ S4 — LA DÉCHARGE : un mouvement ORDINAIRE, une perte ÉNORME (parce que la taille l'était) ═══
    // Verbe visuel : le délavage massif (la grosse jauge s'effondre en gris, la série effacée) vs l'éraflure.
    function s4(lf,t,s){
      const u=t-s; hideQ(); hideDyn();
      // la série de wins (haut), effacée à mesure
      const wipe=clamp((u-1.8)/2.6,0,1);
      for(let i=0;i<7;i++){const gone=clamp(wipe*7-i,0,1);
        const wy=644+9*Math.sin(u*1.6+i*0.6)+4*Math.sin(u*2.8+i*0.4)+34*gone;   // les effacées glissent
        drawCheck(WINS[i],238+i*102,wy,1,mix(YOU,DEAD,gone),1-0.85*gone);}
      // GAUCHE — taille NORMALE : le même mouvement n'est qu'une éraflure
      const nx=176, nbase=1360, nw=110, nh=150+8*Math.sin(u*1.2)+4*Math.sin(u*2.1);
      bar(scratchBar,nx,nw,nbase,nh,0,1,4*Math.sin(u*0.9)+2*Math.sin(u*1.8)); baseLine(scratchBase,nx,nw,nbase,1);
      scratchNick.setAttribute('x',(nx-nw/2).toFixed(1));scratchNick.setAttribute('y',(nbase-nh-16).toFixed(1));
      scratchNick.setAttribute('width',nw);scratchNick.setAttribute('height',(14+2*Math.sin(u*3.0)).toFixed(1));setOp(scratchNick,clamp((u-1.5)/0.6,0,1));
      putCap(capC,'NORMAL SIZE',nx,nbase+64,YOU,1);
      putCap(capE,'JUST A SCRATCH',nx,nbase-nh-40,DEAD,clamp((u-2.0)/0.6,0,1));
      // CENTRE — taille CONFIANCE : la perte énorme, la jauge délavée d'un bloc gris
      const drain=eInOut(clamp((u-1.6)/2.6,0,1));
      const sx=560, sbase=1360, sw=196, full=560;
      const rem=full*(1-0.80*drain), remH=rem+13*Math.sin(u*1.2)+7*Math.sin(u*2.1);
      bar(sizeBar,sx,sw,sbase,remH,0.10+0.70*drain,1,6*Math.sin(u*0.9)+3*Math.sin(u*1.75)); baseLine(sizeBase,sx,sw,sbase,1);
      lossBlock.setAttribute('x',(sx-sw/2).toFixed(1));lossBlock.setAttribute('y',(sbase-full).toFixed(1));
      lossBlock.setAttribute('width',sw);lossBlock.setAttribute('height',Math.max(1,full-rem).toFixed(1));setOp(lossBlock,drain>0.02?0.88:0);
      putCap(capA,'CONFIDENCE SIZE',sx,sbase+64,YOU,1);
      // le mouvement ORDINAIRE du marché : une petite flèche encre, identique pour les deux
      const ay=884+10*Math.sin(u*1.3), ax=748+6*Math.sin(u*1.7);
      drawArrow(mktLine,mktHead, ax, ay, ax, ay+92, 1);
      putCap(capD,'AN ORDINARY MOVE',768,782,INK,clamp((u-0.5)/0.6,0,1));   // au-dessus du bloc (jamais dessus)
      putCap(capB,'THE STREAK ARMED THE TRADE THAT ENDED IT',CX,584,INK,clamp((u-3.0)/0.7,0,1));
    }

    // ═══ S5 — DÉCHARGE DU FUSIL : la confiance regonfle, mais la taille TIENT (drapeau jaune) ═══
    // Verbe visuel : la retenue (la taille refuse de monter) + le fanion d'alerte qui se lève.
    function s5(lf,t,s){
      const u=t-s; hideQ(); hideDyn();
      // CONFIANCE (gauche) : elle regonfle
      const cx=244, cbase=1360, cw=150, ch=470+42*eOut(clamp(u/2.2,0,1))+16*Math.sin(u*1.1)+9*Math.sin(u*1.95);
      bar(confBar,cx,cw,cbase,ch,0,1,5*Math.sin(u*0.85)+2.5*Math.sin(u*1.7)); baseLine(confBase,cx,cw,cbase,1);
      putCap(capA,'CONFIDENCE',cx,cbase+64,YOU,1);
      // TAILLE (centre) : elle RESTE stable — ne monte pas avec la confiance
      const sx=556, sbase=1360, sw=178, hold=306, sh=hold+11*Math.sin(u*1.2)+5*Math.sin(u*2.1);
      bar(sizeBar,sx,sw,sbase,sh,0,1,4*Math.sin(u*0.9)+2*Math.sin(u*1.8)); baseLine(sizeBase,sx,sw,sbase,1);
      putCap(capC,'SIZE — HELD',sx,sbase+64,YOU,1);
      // LE DRAPEAU JAUNE se lève près de la taille et la fait tenir
      const rise=eOut(clamp((u-0.4)/1.3,0,1));
      const fx=sx+sw/2+64, fbaseY=sbase-sh, ftopY=fbaseY-196*rise;
      flagPole.setAttribute('x1',fx);flagPole.setAttribute('x2',fx);flagPole.setAttribute('y1',(fbaseY+12).toFixed(1));flagPole.setAttribute('y2',ftopY.toFixed(1));setOp(flagPole,rise);
      const wave=11*Math.sin(u*3.0)+5*Math.sin(u*5.1);
      flagPenn.setAttribute('points',`${fx},${ftopY.toFixed(1)} ${(fx+94).toFixed(1)},${(ftopY+24+wave).toFixed(1)} ${fx},${(ftopY+50).toFixed(1)}`);setOp(flagPenn,rise);
      putCap(capE,'A YELLOW FLAG, NOT GREEN',fx+30,ftopY-22,WARN,clamp((u-1.4)/0.6,0,1));
      // EDGE (droite) : constante — la taille s'aligne sur elle, pas sur la confiance
      const ex=888, ebase=1300, ew=110, eh=196+4*Math.sin(u*1.3)+2*Math.sin(u*2.4);
      bar(edgeBar,ex,ew,ebase,eh,0,1,4*Math.sin(u*0.9)+2*Math.sin(u*1.9)); baseLine(edgeBase,ex,ew,ebase,1);
      putCap(capD,'EDGE — CONSTANT',ex,ebase+64,YOU,clamp((u-2.0)/0.7,0,1));
      putCap(capB,'STAY THE SAME SIZE — A BONUS, NOT A TRAP',CX,588,INK,clamp((u-2.6)/0.7,0,1));
    }

    const RENDER={s1,s2,s3,s4,s5};const SCENEFN=SPEC.map(s=>RENDER[s.id]||s1);
    const clock={t:0};
    function sceneAt(t){let i=0;for(let k=0;k<SC.length;k++){if(t>=SC[k].s-1e-6)i=k;}return Math.min(i,SCENEFN.length-1);}
    function render(){const t=clock.t;const i=sceneAt(t),lf=clamp((t-SC[i].s)/SC[i].d,0,1);SCENEFN[i](lf,t,SC[i].s);}
    const tl=gsap.timeline({paused:true});
    tl.to(clock,{t:TOTAL,duration:TOTAL,ease:'none',onUpdate:render},0);
    tl.to(SVG,{opacity:1,duration:0.001},TOTAL-0.001);
    window.__timelines=window.__timelines||{};window.__timelines['main']=tl;
  </script>
