# Copier en `.env.local` SUR LE VPS et renseigner les vraies valeurs.
# NE JAMAIS committer .env.local — il est ignoré par git et jamais synchronisé.
# Le token ne doit exister qu'ici, jamais en clair dans le code.

# --- Instagram Content Publishing API (Graph API) ---
# ID du compte Instagram Business (pas le @handle) — via Business Manager.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# System User token longue durée (Business Manager > Utilisateurs système).
# Permissions requises : instagram_basic, instagram_content_publish,
# pages_read_engagement, business_management.
META_ACCESS_TOKEN=

# Version de l'API Graph (optionnel, défaut v20.0).
# GRAPH_VERSION=v20.0

# --- Notifications Telegram ---
# Token du bot créé via @BotFather.
TELEGRAM_BOT_TOKEN=
# ID du chat destinataire (via @userinfobot ou getUpdates).
TELEGRAM_CHAT_ID=
